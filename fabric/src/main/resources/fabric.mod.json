{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "Joosh7889",
        "Xylonity"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/ghost",
        "sources": "https://github.com/BoyAxl/Ghosts-Fabric-Port",
        "issues": "https://github.com/BoyAxl/Ghosts-Fabric-Port/issues"
    },
    "license": "${license}",
    "icon": "ghosts.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "dev.xylonity.bonsai.ghosts.GhostsFabric"
        ],
        "client": [
            "dev.xylonity.bonsai.ghosts.GhostsFabric"
        ]
    },
    "mixins": [
        "ghosts.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${fabric_loader_version_range}",
        "fabric-api": "${fabric_api_version_range}",
        "minecraft": "${minecraft_version_range}",
        "java": ">=${java_version}",
        "geckolib": ">=${geckolib_version}"
    }
}
  
